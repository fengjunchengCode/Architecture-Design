# ========== 视觉模型配置 ==========

# Provider 选择（可选，默认 auto）
# 支持：openai, anthropic, google, auto
# auto 会按优先级自动检测可用的 provider
VISION_PROVIDER=auto

# ----- OpenAI 配置 -----
# 用于 GPT-4o, GPT-4V 等模型
OPENAI_API_KEY=sk-xxx
VISION_MODEL=gpt-4o
# OPENAI_API_BASE=https://api.openai.com/v1  # 可选，用于 Azure 或代理

# ----- Anthropic 配置 -----
# 用于 Claude 3.5 Sonnet, Claude 3 Opus 等模型
ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514  # 可选，默认值

# ----- Google 配置 -----
# 用于 Gemini Pro Vision, Gemini 1.5 等模型
GOOGLE_API_KEY=xxx
# GOOGLE_VISION_MODEL=gemini-1.5-pro  # 可选，默认值

# ========== 高德地图 Web Service 配置 ==========

# 用于 S1 区位/周边/POI/道路检索：
# python _tools/amap_context.py --check
# python _tools/amap_context.py 26-BQ-PARK --location "经度,纬度" --write
AMAP_WEBSERVICE_KEY=your_amap_webservice_key

# ========== 高德地图 JavaScript API 配置 ==========

# 用于本地上传 UI 内嵌地图选点。需在高德控制台创建 Web 端 JSAPI key。
# Referer 白名单请加入：
#   http://127.0.0.1:8765
#   http://localhost:8765
# 如果你改了 uploader 端口，也要把对应端口加入白名单。
AMAP_JSAPI_KEY=your_amap_jsapi_key
# 二选一：若高德控制台启用了安全密钥，可以填 jscode；生产部署更推荐用代理服务地址。
AMAP_JSAPI_SECURITY_JSCODE=your_amap_jsapi_security_jscode
# AMAP_JSAPI_SERVICE_HOST=https://your-domain.example.com/_AMapService
